<Window x:Class="HLAS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLAS"
        Height="500"
        Width="850"
        MinHeight="450"
        MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="HLAS"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Unified HLAS Development Shell"
                       FontSize="16"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Project:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           x:Name="ProjectContextText"
                           Text="No developmental project context"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="User:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           x:Name="UserContextText"
                           Text="No developmental user context"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Role:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           x:Name="RoleContextText"
                           Text="No developmental role context"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Series:"
                           FontWeight="Bold"
                           Margin="0,0,12,0"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           x:Name="SeriesContextText"
                           Text="No developmental series context"/>
            </Grid>
        </Border>

        <Button Grid.Row="4"
                x:Name="ShowContextButton"
                Content="Show Developmental Context"
                Width="220"
                Height="36"
                HorizontalAlignment="Left"
                IsEnabled="True"
                Click="ShowContextButton_Click"/>

        <Border Grid.Row="6"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="12">

            <TextBlock x:Name="CommandResultText"
                       Text="Command routing not yet connected."
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="7"
                   VerticalAlignment="Bottom"
                   Margin="0,20,0,0"
                   Text="Development foundation only — no governed project data is loaded."
                   FontStyle="Italic"/>
    </Grid>
</Window>