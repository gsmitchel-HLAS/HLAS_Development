<Window x:Class="HLAS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLAS"
        Height="620"
        Width="900"
        MinHeight="560"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="HLAS"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Unified HLAS"
                       FontSize="16"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Login name:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         x:Name="LoginNameTextBox"
                         Height="30"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Secret:"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <PasswordBox Grid.Row="0"
                             Grid.Column="3"
                             x:Name="SecretPasswordBox"
                             Height="30"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal">

                    <Button x:Name="BootstrapIdentityButton"
                            Content="Create Initial HLAS User"
                            Width="190"
                            Height="34"
                            Click="BootstrapIdentityButton_Click"
                            IsEnabled="False"/>

                    <Button x:Name="LoginButton"
                            Content="Login"
                            Width="110"
                            Height="34"
                            Margin="12,0,0,0"
                            Click="LoginButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="LogoutButton"
        Content="Logout"
        Width="110"
        Height="34"
        Margin="12,0,0,0"
        Click="LogoutButton_Click"
        IsEnabled="False"/>
                    <Button x:Name="ChangeUserButton"
        Content="Change User"
        Width="120"
        Height="34"
        Margin="12,0,0,0"
        Click="ChangeUserButton_Click"
        IsEnabled="False"/>
                     <TextBlock x:Name="AuthenticationStatusText"
                               Text="Authentication controls not yet connected."
                               Margin="20,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="16">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="NewProjectButton"
                        Content="New HLAS Project"
                        Width="180"
                        Height="36"
                        Click="NewProjectButton_Click"
                        IsEnabled="False"/>

                <Button x:Name="OpenProjectButton"
                        Content="Open Existing Project"
                        Width="190"
                        Height="36"
                        Margin="12,0,0,0"
                        Click="OpenProjectButton_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="6"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Project:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           x:Name="ProjectContextText"
                           Text="No project open"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="User:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           x:Name="UserContextText"
                           Text="No authenticated user"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Role:"
                           FontWeight="Bold"
                           Margin="0,0,12,8"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           x:Name="RoleContextText"
                           Text="None"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Series:"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           x:Name="SeriesContextText"
                           Text="None"/>
            </Grid>
        </Border>

        <Border Grid.Row="8"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="12">

            <TextBlock x:Name="CommandResultText"
                       Text="Operational controls not yet connected."
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="9"
                   x:Name="ProjectStatusFooterText"
                   VerticalAlignment="Bottom"
                   Margin="0,20,0,0"
                   Text="No governed HLAS project is open."
                   FontStyle="Italic"/>
    </Grid>
</Window>